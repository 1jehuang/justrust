+// Only listing work nested under multi-crate workers is flattened. No query cache or
+// compiler scheduling state depends on this flag, which is frozen at process first use.
+fn listing_flat_threads() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| listing_exact_flag(std::env::var_os("RA_JIT_LISTING_FLAT_THREADS").as_deref()))
+}
+
+fn listing_exact_flag(value: Option<&std::ffi::OsStr>) -> bool {
+    value == Some(std::ffi::OsStr::new("1"))
+}
+
+thread_local! {
+    static LISTING_WORKER_DEPTH: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+    #[cfg(test)]
+    static LISTING_TEST_FLAG: std::cell::Cell<Option<bool>> = const { std::cell::Cell::new(None) };
+    #[cfg(test)]
+    static LISTING_ROUTES: std::cell::Cell<[usize; 4]> = const { std::cell::Cell::new([0; 4]) };
+}
+
+struct ListingWorker(usize);
+
+impl ListingWorker {
+    fn enter(active: bool) -> Self {
+        let prior = LISTING_WORKER_DEPTH.get();
+        if active {
+            LISTING_WORKER_DEPTH.set(prior + 1);
+        }
+        Self(prior)
+    }
+}
+
+impl Drop for ListingWorker {
+    fn drop(&mut self) {
+        LISTING_WORKER_DEPTH.set(self.0);
+    }
+}
+
+#[derive(Clone, Copy)]
+enum ListingRoute {
+    Lower,
+    Exported,
+}
+
+fn listing_flatten(route: ListingRoute) -> bool {
+    let enabled = listing_flat_threads();
+    #[cfg(test)]
+    let enabled = LISTING_TEST_FLAG.get().unwrap_or(enabled);
+    let flat = enabled && LISTING_WORKER_DEPTH.get() > 0;
+    #[cfg(test)]
+    LISTING_ROUTES.with(|counts| {
+        let mut next = counts.get();
+        next[(route as usize) * 2 + usize::from(flat)] += 1;
+        counts.set(next);
+    });
+    if flat {
+        static MARKED: std::sync::Once = std::sync::Once::new();
+        MARKED.call_once(|| {
+            use std::io::Write;
+            let _ = writeln!(std::io::stderr(), "listing: v70 flat nested branch activated");
+        });
+    }
+    let _ = route;
+    flat
+}
