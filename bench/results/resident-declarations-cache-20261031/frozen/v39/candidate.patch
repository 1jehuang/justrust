+/// Called only behind the exact default-off flag in the measured native declaration owner.
+/// Historical frozen modes retain their existing behavior. In particular off never reads
+/// or writes this experiment and check/verify continue to execute the original walk.
+pub(crate) fn declarations_or_walk(
+    db: &ide_db::RootDatabase,
+    krate: hir::Crate,
+) -> crate::Declared {
+    if mode() != Some(Mode::Serve) {
+        declarations_fallback("frozen-mode");
+        return crate::declared_in_original(db, krate);
+    }
+    let Some(store) = ra_jit_store::Store::global() else {
+        declarations_fallback("no-store");
+        return crate::declared_in_original(db, krate);
+    };
+    let closure = declarations_closure(db, krate.into());
+    if !declarations_eligible(db, &closure) {
+        declarations_fallback("unsupported-origin-or-source-root");
+        return crate::declared_in_original(db, krate);
+    }
+    if !declarations_reads_supported(db, &closure) {
+        declarations_fallback("unsupported-external-or-pending-read");
+        return crate::declared_in_original(db, krate);
+    }
+    let Some(key) = declarations_certificate(db, &closure) else {
+        declarations_fallback("uncertifiable-input");
+        return crate::declared_in_original(db, krate);
+    };
+    if let Some(bytes) = store.get(&key) {
+        if let Ok(value) = decode_declarations(db, krate.into(), &key, &bytes)
+            && declarations_reads_supported(db, &closure)
+        {
+            let hits = DECLARATIONS_HITS.fetch_add(1, Relaxed) + 1;
+            if std::env::var_os("RA_JIT_STATS").is_some() {
+                eprintln!("declarations-cache: native_hit=1 native_hits={hits}");
+            }
+            return value;
+        }
+    }
+    declarations_fallback("miss-or-unreadable");
+    let value = crate::declared_in_original(db, krate);
+    // Includes can load new source or discover external reads while walking. Certify again
+    // and write only if the full original inputs remained the ones looked up above.
+    if declarations_reads_supported(db, &closure)
+        && declarations_eligible(db, &closure)
+        && declarations_certificate(db, &closure) == Some(key)
+    {
+        if let Ok(bytes) = encode_declarations(db, krate.into(), &key, &value)
+            && declarations_reads_supported(db, &closure)
+            && declarations_certificate(db, &closure) == Some(key)
+        {
+            store.insert(&key, &bytes);
+        }
+    }
+    value
+}
 
