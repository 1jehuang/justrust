+/// A bounded schema-12 SHA state, owned by one compilation's Entries, never global.
+/// Only process-immutable configuration belongs here. The frame-pointer and
+/// link-dead-code atomics are deliberately read for every key, just as in Entry::key.
+struct EntryKeyPrefix(Sha256);
+
+impl EntryKeyPrefix {
+    fn enabled(value: Option<&std::ffi::OsStr>) -> bool {
+        value == Some(std::ffi::OsStr::new("1"))
+    }
+
+    fn configured(
+        value: Option<&std::ffi::OsStr>,
+        prepare: impl FnOnce() -> Option<Self>,
+    ) -> Option<Self> {
+        if Self::enabled(value) { prepare() } else { None }
+    }
+
+    fn prepare(program: Option<&[u8; 32]>) -> Option<Self> {
+        let backend = super::Backend::from_env().ok()?.to_string();
+        let level = super::mir_opt_level().number();
+        let target = super::Target::selected().ok()?;
+        Some(Self::of(program, backend.as_bytes(), level, target.triple().as_bytes()))
+    }
+
+    fn field(hasher: &mut Sha256, bytes: &[u8]) {
+        hasher.update((bytes.len() as u64).to_le_bytes());
+        hasher.update(bytes);
+    }
+
+    fn of(program: Option<&[u8; 32]>, backend: &[u8], level: u8, target: &[u8]) -> Self {
+        let mut hasher = Sha256::new();
+        Self::field(&mut hasher, b"ra-jit entry 12");
+        Self::field(&mut hasher, program.map_or(&[][..], |it| it));
+        Self::field(&mut hasher, backend);
+        if level != 0 {
+            Self::field(&mut hasher, &[b'M', level]);
+        }
+        Self::field(&mut hasher, target);
+        Self(hasher)
+    }
+
+    fn key(
+        &self,
+        name: &str,
+        debug: Told,
+        frame_pointers: bool,
+        links_dead_code: bool,
+    ) -> [u8; KEY] {
+        let mut hasher = self.0.clone();
+        if frame_pointers {
+            Self::field(&mut hasher, b"frame pointers");
+        }
+        if links_dead_code {
+            Self::field(&mut hasher, b"link dead code");
+        }
+        Self::field(&mut hasher, &[(debug != Told::Nothing) as u8]);
+        if debug == Told::Lines {
+            Self::field(&mut hasher, b"lines alone");
+        }
+        Self::field(&mut hasher, name.as_bytes());
+        hasher.finalize().into()
+    }
+}
