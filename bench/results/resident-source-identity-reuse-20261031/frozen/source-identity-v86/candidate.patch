+    // Full accepted manifest_source, deliberately independent of the candidate helper.
+    fn original_manifest_source(
+        source: &str,
+        config: &Config,
+    ) -> Result<blaze_manifest::source::SourceId> {
+        use blaze_manifest::source::{CRATES_IO_INDEX, SourceId};
+        use cargo_util_schemas::core::GitReference;
+        let (kind, rest) = source.split_once('+').context("a source with no kind")?;
+        match kind {
+            "registry" if rest == CRATES_IO_INDEX => SourceId::crates_io(config),
+            "registry" => Ok(SourceId::for_registry(&rest.parse()?)),
+            "sparse" => Ok(SourceId::for_registry(&source.parse()?)),
+            "git" => {
+                let mut url: url::Url = rest.parse()?;
+                let query: BTreeMap<String, String> = url.query_pairs().into_owned().collect();
+                let reference = match (query.get("branch"), query.get("tag"), query.get("rev")) {
+                    (Some(branch), _, _) => GitReference::Branch(branch.clone()),
+                    (_, Some(tag), _) => GitReference::Tag(tag.clone()),
+                    (_, _, Some(rev)) => GitReference::Rev(rev.clone()),
+                    _ => GitReference::DefaultBranch,
+                };
+                url.set_fragment(None);
+                url.set_query(None);
+                Ok(SourceId::for_git(&url, reference))
+            }
+            _ => bail!("the source {source} is not one blaze reads yet"),
+        }
+    }
+
+    #[test]
+    fn repeated_mixed_exact_strings_full_identity_and_warnings() {
+        let fixture = Fixture::new();
+        fixture.config_text("[registries.crates-io]\nprotocol = 'git'\n");
+        let original = fixture.config();
+        let candidate = fixture.config();
+        let mut reuse = SourceIdentityReuse::default();
+        let sources = [
+            "registry+https://github.com/rust-lang/crates.io-index",
+            "registry+https://example.invalid/index",
+            "registry+https://example.invalid/index/",
+            "sparse+https://example.invalid/index/",
+            "git+https://example.invalid/repo?branch=hello%20world#1234",
+            "git+https://example.invalid/repo?tag=v1#5678",
+            "git+https://example.invalid/repo?rev=abc#1234",
+            "git+https://example.invalid/repo#1234",
+            "git+https://example.invalid/repo?branch=x&tag=y&rev=z#1234",
+        ];
+        for _ in 0..2 {
+            for source in sources {
+                assert_eq!(
+                    reuse.resolve(source, &candidate).unwrap(),
+                    original_manifest_source(source, &original).unwrap()
+                );
+                assert_eq!(candidate.take_warnings(), original.take_warnings());
+            }
+        }
+        assert_eq!(reuse.successful.len(), sources.len());
+        assert_eq!(reuse.hits, sources.len());
+    }
+
+    #[test]
+    fn cached_cratesio_hit_preserves_new_config_read_warnings() {
+        let fixture = Fixture::new();
+        let cratesio = "registry+https://github.com/rust-lang/crates.io-index";
+        let mut reuse = SourceIdentityReuse::default();
+        reuse.resolve(cratesio, &fixture.config()).unwrap();
+        fixture.config_text("");
+        std::fs::write(fixture.0.join(".cargo/config"), "").unwrap();
+        let candidate = fixture.config();
+        let original = fixture.config();
+        assert_eq!(
+            reuse.resolve(cratesio, &candidate).unwrap(),
+            original_manifest_source(cratesio, &original).unwrap()
+        );
+        let expected = original.take_warnings();
+        assert!(!expected.is_empty());
+        assert_eq!(candidate.take_warnings(), expected);
+        assert_eq!(reuse.hits, 1);
+    }
+
+    #[test]
+    fn failures_are_not_cached_and_cratesio_revalidates_on_hits() {
+        let fixture = Fixture::new();
+        let config = fixture.config();
+        let mut reuse = SourceIdentityReuse::default();
+        let cratesio = "registry+https://github.com/rust-lang/crates.io-index";
+        reuse.resolve(cratesio, &config).unwrap();
+        fixture.config_text("[registry]\nindex = 'https://example.invalid/'\n");
+        let changed = fixture.config();
+        let original = fixture.config();
+        for source in [cratesio, "no-kind", "registry+not a url", "path+file:///tmp/a", cratesio] {
+            let got = reuse.resolve(source, &changed).unwrap_err();
+            let expected = original_manifest_source(source, &original).unwrap_err();
+            assert_eq!(format!("{got:#}"), format!("{expected:#}"));
+            assert_eq!(changed.take_warnings(), original.take_warnings());
+        }
+        assert_eq!(reuse.successful.len(), 1);
+        assert_eq!(reuse.hits, 0);
+        let mut fresh = SourceIdentityReuse::default();
+        assert!(fresh.resolve(cratesio, &fixture.config()).is_err());
+        assert!(fresh.successful.is_empty());
+        fixture.config_text("[registry]\nindex = 42\n");
+        let invalid = fixture.config();
+        assert_eq!(
+            format!("{:#}", reuse.resolve(cratesio, &invalid).unwrap_err()),
+            format!("{:#}", original_manifest_source(cratesio, &fixture.config()).unwrap_err())
+        );
+        fixture.config_text("");
+        assert_eq!(
+            fresh.resolve(cratesio, &fixture.config()).unwrap(),
+            original_manifest_source(cratesio, &fixture.config()).unwrap()
+        );
+        assert_eq!(fresh.hits, 0);
+    }
+
+    fn observe_fetch(
+        fixture: &Fixture,
+        ids: &[PackageId],
+        candidate: bool,
+    ) -> (Result<Vec<(PathBuf, Option<String>, serde_json::Value)>, String>, Vec<String>) {
+        let ctx = Context::new(fixture.config());
+        let result = (|| -> Result<_> {
+            let sources = sources(&ctx, true, None, true, None)?;
+            let packages = if candidate {
+                fetch_source_identity_reuse(ids, &FxHashMap::default(), &ctx, &sources)?
+            } else {
+                fetch_original(ids, &FxHashMap::default(), &ctx, &sources)?
+            };
+            packages
+                .into_iter()
+                .map(|p| {
+                    let value =
+                        serde_json::to_value(export_package(&p.manifest_path, &p.manifest))?;
+                    Ok((p.manifest_path, p.locked_source, value))
+                })
+                .collect()
+        })()
+        .map_err(|e| format!("{e:#}"));
+        (result, ctx.config.take_warnings())
+    }
+
+    #[test]
+    fn full_fetch_packages_paths_order_errors_and_warnings() {
+        let fixture = Fixture::new();
+        let vendor = fixture.0.join("vendor");
+        std::fs::create_dir(&vendor).unwrap();
+        for name in ["first", "second"] {
+            let dir = vendor.join(name);
+            std::fs::create_dir(&dir).unwrap();
+            std::fs::create_dir(dir.join("src")).unwrap();
+            std::fs::write(dir.join("src/lib.rs"), "").unwrap();
+            std::fs::write(
+                dir.join("Cargo.toml"),
+                format!("[package]\nname = '{name}'\nversion = '1.0.0'\nedition = '2021'\n"),
+            )
+            .unwrap();
+            std::fs::write(dir.join(".cargo-checksum.json"), r#"{"package":null,"files":{}}"#)
+                .unwrap();
+        }
+        fixture.config_text(&format!(
+            "[source.crates-io]\nreplace-with = 'vendored'\n[source.vendored]\ndirectory = {}\n",
+            toml::Value::String(vendor.to_str().unwrap().into())
+        ));
+        let source = blaze_resolve::SourceId::from_url(
+            "registry+https://github.com/rust-lang/crates.io-index",
+        )
+        .unwrap();
+        let ids = [
+            PackageId::try_new("second", "1.0.0", source).unwrap(),
+            PackageId::try_new("first", "1.0.0", source).unwrap(),
+        ];
+        let original = observe_fetch(&fixture, &ids, false);
+        let candidate = observe_fetch(&fixture, &ids, true);
+        assert_eq!(candidate, original);
+        let packages = candidate.0.unwrap();
+        assert_eq!(packages.len(), 2);
+        assert_eq!(packages[0].0, vendor.join("second/Cargo.toml"));
+        assert_eq!(packages[1].0, vendor.join("first/Cargo.toml"));
+        // A semantic manifest failure after fetching must stay at the first read in ID order.
+        std::fs::write(
+            vendor.join("second/Cargo.toml"),
+            "[package]\nname = 'second'\nversion = '1.0.0'\nedition = 'bogus'\n",
+        )
+        .unwrap();
+        let original = observe_fetch(&fixture, &ids, false);
+        assert!(original.0.is_err());
+        assert_eq!(observe_fetch(&fixture, &ids, true), original);
+    }
+}
