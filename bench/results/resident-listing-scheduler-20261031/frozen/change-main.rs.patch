     use super::*;
 
+    struct ListingTestFlag(Option<bool>);
+
+    impl ListingTestFlag {
+        fn set(enabled: bool) -> Self {
+            Self(LISTING_TEST_FLAG.replace(Some(enabled)))
+        }
+    }
+
+    impl Drop for ListingTestFlag {
+        fn drop(&mut self) {
+            LISTING_TEST_FLAG.set(self.0);
+        }
+    }
+
+    #[test]
+    fn listing_v70_exact_flag_and_unwind_isolation() {
+        for value in [None, Some(""), Some("0"), Some("true"), Some("01"), Some("1 ")] {
+            assert!(!listing_exact_flag(value.map(std::ffi::OsStr::new)));
+        }
+        assert!(listing_exact_flag(Some(std::ffi::OsStr::new("1"))));
+        let _flag = ListingTestFlag::set(true);
+        assert_eq!(LISTING_WORKER_DEPTH.get(), 0);
+        let outer = ListingWorker::enter(true);
+        assert_eq!(LISTING_WORKER_DEPTH.get(), 1);
+        let unwind = std::panic::catch_unwind(|| {
+            let _inner = ListingWorker::enter(true);
+            assert_eq!(LISTING_WORKER_DEPTH.get(), 2);
+            panic!("listing guard fixture");
+        });
+        assert!(unwind.is_err());
+        assert_eq!(LISTING_WORKER_DEPTH.get(), 1);
+        std::thread::scope(|scope| {
+            scope.spawn(|| {
+                assert_eq!(LISTING_WORKER_DEPTH.get(), 0);
+                let _flag = ListingTestFlag::set(true);
+                assert!(!listing_flatten(ListingRoute::Lower));
+            }).join().unwrap();
+        });
+        assert!(listing_flatten(ListingRoute::Lower));
+        drop(outer);
+        assert_eq!(LISTING_WORKER_DEPTH.get(), 0);
+        assert!(!listing_flatten(ListingRoute::Exported));
+    }
+
