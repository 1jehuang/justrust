+/// Opportunistically parse a sufficiently large batch of regular Cargo.toml files.
+/// The caller alone decides whether the experimental mode is enabled. A fresh batch
+/// owns fresh bytes, not a cache. Unsupported platforms and special files fall back.
+pub fn preparse_manifests(paths: &[PathBuf]) -> Option<Vec<ParsedManifest>> {
+    if paths.len() < 8
+        || paths.iter().any(|path| {
+            path.file_name() != Some(std::ffi::OsStr::new("Cargo.toml"))
+                || !std::fs::symlink_metadata(path).is_ok_and(|m| m.file_type().is_file())
+        })
+    {
+        return None;
+    }
+    preparse_regular_manifests(paths)
+}
+
+#[cfg(not(all(target_os = "linux", target_arch = "x86_64")))]
+fn preparse_regular_manifests(_: &[PathBuf]) -> Option<Vec<ParsedManifest>> {
+    None
+}
+
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+fn preparse_regular_manifests(paths: &[PathBuf]) -> Option<Vec<ParsedManifest>> {
+    use std::io::{Read as _, Write as _};
+    use std::os::unix::fs::OpenOptionsExt as _;
+
+    fn read_regular(path: &Path) -> Option<anyhow::Result<TomlManifest>> {
+        // Linux O_NONBLOCK: if a regular path is replaced by a FIFO between
+        // preflight and open, opening it must not wait for a writer. Verify the
+        // opened handle as well. This is not a filesystem snapshot guarantee.
+        // O_NOFOLLOW also declines a last-component symlink introduced after
+        // preflight. Flag values here are specific to Linux x86_64.
+        let mut file =
+            std::fs::OpenOptions::new().read(true).custom_flags(0x800 | 0x20000).open(path).ok()?;
+        if !file.metadata().ok()?.is_file() {
+            return None;
+        }
+        let mut bytes = Vec::new();
+        Some((|| {
+            file.read_to_end(&mut bytes)
+                .with_context(|| format!("failed to read `{}`", path.display()))?;
+            parse_manifest_syntax(bytes_to_contents(bytes, path)?, path)
+        })())
+    }
+
+    let workers = std::thread::available_parallelism().map_or(2, usize::from).clamp(2, 4);
+    let parsed = schedule_manifest_syntax(paths.len(), workers, |index| ParsedManifest {
+        path: paths[index].clone(),
+        syntax: read_regular(&paths[index]),
+    })?;
+    // Same fixed v81 factor contract, but a distinct v82 binary/source identity.
+    // Emit only after a bounded batch actually ran, never merely for flag eligibility.
+    static MARKER: std::sync::Once = std::sync::Once::new();
+    MARKER.call_once(|| {
+        let _ = writeln!(std::io::stderr().lock(), "ra-jit: parallel-manifest-parse-v81 batch");
+    });
+    Some(parsed)
+}
 
+/// Each worker claims one manifest at a time. Completion order never controls
+/// semantic lowering or error selection: only the caller consumes input order.
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+fn schedule_manifest_syntax<T: Send>(
+    len: usize,
+    workers: usize,
+    read: impl Fn(usize) -> T + Sync,
+) -> Option<Vec<T>> {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    if len < 8 || !(2..=4).contains(&workers) {
+        return None;
+    }
+    let next = AtomicUsize::new(0);
+    std::thread::scope(|scope| {
+        let mut handles = Vec::with_capacity(workers);
+        let mut failed = false;
+        for _ in 0..workers {
+            let next = &next;
+            let read = &read;
+            let handle = std::thread::Builder::new()
+                .name("manifest-syntax".into())
+                .spawn_scoped(scope, move || {
+                    let mut local = Vec::with_capacity(len.div_ceil(workers));
+                    loop {
+                        let index = next.fetch_add(1, Ordering::Relaxed);
+                        if index >= len {
+                            break;
+                        }
+                        local.push((index, read(index)));
+                    }
+                    local
+                });
+            match handle {
+                Ok(handle) => handles.push(handle),
+                Err(_) => {
+                    failed = true;
+                    break;
+                }
+            }
+        }
+        let mut ordered: Vec<Option<T>> = (0..len).map(|_| None).collect();
+        // Join every started thread even on spawn failure or an unwinding worker.
+        // Never let scope's implicit join turn a recoverable worker failure into
+        // a caller panic. Normal read/UTF-8/TOML errors are values, not fallbacks.
+        for handle in handles {
+            match handle.join() {
+                Ok(local) => {
+                    for (index, value) in local {
+                        ordered[index] = Some(value);
+                    }
+                }
+                Err(_) => failed = true,
+            }
+        }
+        if failed {
+            return None;
+        }
+        ordered.into_iter().collect()
+    })
+}
