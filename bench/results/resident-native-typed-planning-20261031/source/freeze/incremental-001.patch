+/// Native v83 conversion of the exported representation. The JSON reader above remains
+/// an independent oracle. In particular rust-version and publication time remain unset,
+/// just as `read` leaves them, and the caller installs the lock checksum afterwards.
+pub(crate) fn read_typed(
+    package: &blaze_manifest::metadata::SerializedPackage<'_>,
+) -> Result<Read> {
+    let p = package.planning();
+    // Path's serde implementation rejects non-UTF-8. Preserve its exact error on this
+    // exceptional input rather than silently accepting a path the JSON oracle refuses.
+    if p.manifest_path.to_str().is_none()
+        || p.dependencies.iter().any(|d| d.planning().path.is_some_and(|p| p.to_str().is_none()))
+        || p.targets.iter().any(|t| t.planning_path().to_str().is_none())
+    {
+        return read(&serde_json::to_value(package)?);
+    }
+    static ENTERED: std::sync::Once = std::sync::Once::new();
+    ENTERED.call_once(|| {
+        use std::io::Write as _;
+        let _ = writeln!(std::io::stderr().lock(), "ra-jit: native-typed-planning-v83 entered");
+    });
+    let source = match p.source {
+        Some(source) => SourceId::from_url(source)?,
+        None => SourceId::for_path(p.manifest_path.parent().context("a manifest's dir")?)?,
+    };
+    let id = blaze_resolve::PackageId::try_new(p.name, &p.version.to_string(), source)?;
+    let deps = p
+        .dependencies
+        .iter()
+        .map(|dep| {
+            let d = dep.planning();
+            let source = match (d.source, d.path) {
+                (Some(source), _) => SourceId::from_url(source)?,
+                (None, Some(path)) => SourceId::for_path(path)?,
+                (None, None) => SourceId::crates_io(),
+            };
+            let req = match d.req {
+                "*" if !source.is_registry() => None,
+                req => Some(req),
+            };
+            let mut out = Dependency::parse(d.name, req, source)?;
+            out.set_kind(match d.kind {
+                blaze_manifest::dependency::DepKind::Normal => DepKind::Normal,
+                blaze_manifest::dependency::DepKind::Development => DepKind::Development,
+                blaze_manifest::dependency::DepKind::Build => DepKind::Build,
+            });
+            if let Some(rename) = d.rename {
+                out.set_explicit_name_in_toml(rename);
+            }
+            out.set_optional(d.optional);
+            out.set_default_features(d.uses_default_features);
+            out.set_features(d.features.iter().map(String::as_str));
+            if let Some(target) = d.target {
+                // Keep the serialized platform's parse and diagnostics, not an unchecked clone.
+                out.set_platform(Some(target.to_string().parse::<Platform>()?));
+            }
+            Ok(out)
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let features: BTreeMap<InternedString, Vec<InternedString>> = p
+        .features
+        .iter()
+        .map(|(name, values)| {
+            (
+                InternedString::new(name),
+                values.iter().map(|value| InternedString::new(value)).collect(),
+            )
+        })
+        .collect();
+    let summary = Summary::new(id, deps, &features, p.links, None)?;
+    let lib = p.targets.iter().find(|t| LIB_KINDS.iter().any(|k| t.planning_kind(k)));
+    Ok(Read {
+        summary,
+        lib: lib.map(|t| InternedString::new(&t.planning_name().replace('-', "_"))),
+        proc_macro_lib: lib.is_some_and(|t| t.planning_kind("proc-macro")),
+        any_proc_macro: p.targets.iter().any(|t| t.planning_kind("proc-macro")),
+        build_script: p.targets.iter().any(|t| t.planning_kind("custom-build")),
+        bins: p
+            .targets
+            .iter()
+            .filter(|t| t.planning_kind("bin"))
+            .map(|t| t.planning_required().to_vec())
+            .collect(),
+        license: p.license.map(str::to_owned),
+        repository: p.repository.map(str::to_owned),
+    })
+}
