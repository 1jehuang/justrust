+    #[cfg(target_os = "linux")]
+    fn read(path: &Path) -> Option<Self> {
+        use std::{
+            fs::OpenOptions,
+            io::Read,
+            os::unix::fs::{MetadataExt, OpenOptionsExt},
+        };
+        let identity = |m: &std::fs::Metadata| {
+            (
+                m.dev(),
+                m.ino(),
+                m.mode(),
+                m.len(),
+                m.mtime(),
+                m.mtime_nsec(),
+                m.ctime(),
+                m.ctime_nsec(),
+            )
+        };
+        let before = std::fs::symlink_metadata(path).ok()?;
+        let link = if before.file_type().is_symlink() {
+            Some(std::fs::read_link(path).ok()?)
+        } else {
+            None
+        };
+        let canonical = path.canonicalize().ok()?;
+        // Reject nonregular targets before opening, including FIFOs.
+        let target = std::fs::metadata(path).ok()?;
+        if !target.is_file() {
+            return None;
+        }
+        // Linux O_NONBLOCK prevents a concurrent replacement with a FIFO from hanging.
+        let mut file = OpenOptions::new().read(true).custom_flags(0x800).open(path).ok()?;
+        let opened = file.metadata().ok()?;
+        if !opened.is_file() || identity(&target) != identity(&opened) {
+            return None;
+        }
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes).ok()?;
+        if identity(&opened) != identity(&file.metadata().ok()?)
+            || identity(&opened) != identity(&std::fs::metadata(path).ok()?)
+            || identity(&before) != identity(&std::fs::symlink_metadata(path).ok()?)
+            || canonical != path.canonicalize().ok()?
+            || bytes.len() as u64 != opened.len()
+        {
+            return None;
+        }
+        Some(Self { canonical, link, bytes })
+    }
