+/// Owned syntax for exactly one path. No configuration or workspace state crosses a thread.
+pub struct ParsedManifest {
+    path: PathBuf,
+    syntax: Option<anyhow::Result<TomlManifest>>,
+}
+
+impl ParsedManifest {
+    /// Complete the original semantic body on the caller's thread, in input order.
+    pub fn read(self, source_id: SourceId, ctx: &Context) -> anyhow::Result<EitherManifest> {
+        match self.syntax {
+            Some(syntax) => normalize_manifest(syntax?, &self.path, source_id, ctx),
+            None => read_manifest(&self.path, source_id, ctx),
+        }
+    }
+}
