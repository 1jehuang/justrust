+                    assert_eq!(load(&candidate), load(&original), "{}: {name}", MISS_LABELS[index]);
+                }
+                for node in &names {
+                    assert_eq!(
+                        candidate.usable.shard(node.as_str()).get(node.as_str()).copied(),
+                        original.usable.shard(node.as_str()).get(node.as_str()).copied(),
+                        "settled {node}"
+                    );
+                }
+            }
+            assert_eq!(observed(&candidate, Miss::TransitiveFailure), u64::from(failure != 0));
