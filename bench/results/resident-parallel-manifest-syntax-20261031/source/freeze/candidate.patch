+/// Opportunistically parse a sufficiently large batch of regular Cargo.toml files.
+/// The caller alone decides whether the experimental mode is enabled. A fresh batch
+/// owns fresh bytes, not a cache. Unsupported platforms and special files fall back.
+pub fn preparse_manifests(paths: &[PathBuf]) -> Option<Vec<ParsedManifest>> {
+    if paths.len() < 8
+        || paths.iter().any(|path| {
+            path.file_name() != Some(std::ffi::OsStr::new("Cargo.toml"))
+                || !std::fs::symlink_metadata(path).is_ok_and(|m| m.file_type().is_file())
+        })
+    {
+        return None;
+    }
+    preparse_regular_manifests(paths)
+}
 
+#[cfg(not(all(target_os = "linux", target_arch = "x86_64")))]
+fn preparse_regular_manifests(_: &[PathBuf]) -> Option<Vec<ParsedManifest>> {
+    None
+}
