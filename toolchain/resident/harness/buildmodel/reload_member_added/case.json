{
  "row": "reload: a new workspace member",
  "package": "app",
  "crates": [
    "app"
  ],
  "steps": [
    {
      "what": "a member is added and depended on",
      "write": {
        "tool/Cargo.toml": "[package]\nname = \"tool\"\nversion = \"0.1.0\"\nedition = \"2021\"\n",
        "tool/src/lib.rs": "pub fn name() -> &'static str {\n    \"tool\"\n}\n"
      },
      "edit": [
        [
          "Cargo.toml",
          "members = [\"app\"]",
          "members = [\"app\", \"tool\"]"
        ],
        [
          "app/Cargo.toml",
          "[dependencies]\n",
          "[dependencies]\ntool = { path = \"../tool\" }\n"
        ],
        [
          "app/src/main.rs",
          "\"alone\".to_owned()",
          "format!(\"with {}\", tool::name())"
        ]
      ]
    },
    {
      "what": "the new member's source changes",
      "edit": [
        [
          "tool/src/lib.rs",
          "\"tool\"",
          "\"tool anew\""
        ]
      ]
    }
  ]
}
