+        compiled: &CompiledFunction,
+        debug: bool,
+    ) -> Mark {
+        let mut lines = rustc_hash::FxHasher::default();
+        if debug && let Some((owner, spans)) = &compiled.source {
+            for row in &compiled.code.lines {
