+#[test]
+fn expansion_recorder_early_rearm() {
+    use super::*;
+    const CHILD: &str = "JR_TEST_EARLY_PHASE_REARM";
+    if std::env::var_os(CHILD).is_none() {
+        let dir = tempfile::tempdir().unwrap();
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "profiling::tests::expansion_recorder_early_rearm"])
+            .env(CHILD, "1")
+            .env("JUSTRUST_RUSTC_PHASES_FILE", dir.path().join("test.tsv"))
+            .env("JUSTRUST_EXPERIMENT_INDEXED_PHASES", "1")
+            .status()
+            .unwrap();
+        assert!(status.success());
+        assert!(dir.path().join("test.tsv").is_file());
+        return;
+    }
+    let path = std::env::var_os("JUSTRUST_RUSTC_PHASES_FILE").unwrap();
+    let label = "expand_declarative_bang";
+    std::thread::scope(|scope| {
+        for _ in 0..4 {
+            scope.spawn(|| {
+                for _ in 0..100 {
+                    drop(jr_expansion_phase(label));
+                }
+            });
+        }
+    });
+    jr_phases_write_now();
+    let early = fs::read_to_string(&path).unwrap();
+    let check = |text: &str, count: &str| {
+        let mut lines = text.lines();
+        let fields: Vec<_> = lines.next().unwrap().split('\t').collect();
+        assert_eq!(fields.len(), 3);
+        assert_eq!(fields[0], label);
+        assert!(fields[1].parse::<f64>().unwrap() >= 0.0);
+        assert_eq!(fields[2], count);
+        assert!(lines.next().unwrap().starts_with("total\t"));
+        assert!(lines.next().is_none());
+    };
+    check(&early, "400");
+    jr_phase_add(label, Duration::from_secs(1));
+    jr_phases_write(Duration::from_secs(2));
+    assert_eq!(fs::read_to_string(&path).unwrap(), early);
+    jr_phases_rearm();
+    jr_phases_write(Duration::from_secs(2));
+    let final_rows = fs::read_to_string(&path).unwrap();
+    check(&final_rows, "401");
+    assert!(final_rows.ends_with("total\t2.000000\t1\n"));
+}
+
+#[test]
+#[ignore = "paired phase-recorder microbenchmark; run explicitly"]
+fn six_label_guard_cost() {
+    use super::*;
+    const NAME: &str = "profiling::tests::six_label_guard_cost";
+    let iterations = 1_200_000;
+    let Ok(arm) = std::env::var("JR_TEST_PHASE_ARM") else {
+        let dir = tempfile::tempdir().unwrap();
+        for i in 0..16 {
+            let arms = if i % 2 == 0 { ["map", "indexed"] } else { ["indexed", "map"] };
+            for arm in arms {
+                let status = std::process::Command::new(std::env::current_exe().unwrap())
+                    .args(["--exact", NAME, "--ignored", "--nocapture"])
+                    .env("JR_TEST_PHASE_ARM", arm)
+                    .env("JUSTRUST_RUSTC_PHASES_FILE", dir.path().join("micro.tsv"))
+                    .env("JUSTRUST_EXPERIMENT_INDEXED_PHASES", "1")
+                    .status()
+                    .unwrap();
+                assert!(status.success());
+            }
+        }
+        return;
+    };
+    macro_rules! run {
+        ($guard:ident) => {{
+            let start = Instant::now();
+            for _ in 0..iterations / 6 {
+                drop($guard("expand_resolve_dollar_crates"));
+                drop($guard("expand_collect_invocations"));
+                drop($guard("expand_build_reduced_graph"));
+                drop($guard("expand_declarative_bang"));
+                drop($guard("expand_declarative_attr"));
+                drop($guard("expand_declarative_derive"));
+            }
+            start.elapsed()
+        }};
+    }
+    let elapsed = if arm == "map" { run!(jr_phase) } else { run!(jr_expansion_phase) };
+    let rows = jr_phase_ledger().unwrap().phases.lock().snapshot();
+    assert_eq!(rows.len(), 6);
+    assert!(rows.values().all(|&(_, count)| count == iterations / 6));
+    println!("phase_guard_ns {arm} {:.3}", elapsed.as_nanos() as f64 / iterations as f64);
+}
