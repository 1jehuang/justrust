 /// When `file` was last written, as a stamp.
 fn written_at(file: &Path) -> Option<u128> {
     let written = std::fs::metadata(file).and_then(|it| it.modified()).ok()?;
     Some(written.duration_since(std::time::UNIX_EPOCH).ok()?.as_nanos())
 }
 
