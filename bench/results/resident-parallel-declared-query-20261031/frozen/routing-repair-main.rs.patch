+    #[test]
+    fn parallel_declared_query_production_routes_small_multi_and_transition_waves() {
+        use ide_db::base_db::salsa::Durability;
+        use test_fixture::WithFixture;
+        let mut source = String::from("fn main() { fn only_nested() {} }\n");
+        for i in 0..48 {
+            source.push_str(&format!("fn plain_{i}() {{}}\n"));
+        }
+        let (mut db, file) = RootDatabase::with_single_file(&source);
+        let file = file.file_id(&db);
+        hir::attach_db(&db, || {
+            let krate =
+                hir::Semantics::new(&db).file_to_module_defs(file).next().unwrap().krate(&db);
+            let bodies = module_declarations(&db, krate.into()).bodies.clone();
+            assert_eq!(bodies.len(), 49, "must exercise actual large wave");
+            let small = bodies[..1].to_vec();
+            DECLARATION_PREWARM_ROUTES.set((0, 0));
+            // This is the exact production helper, under the original database's
+            // HIR attachment. A cloned small-wave attachment would panic here.
+            assert!(prewarm_declaration_bodies(&db, small.clone()) == small);
+            assert_eq!(DECLARATION_PREWARM_ROUTES.get(), (1, 0));
+            assert!(prewarm_declaration_bodies(&db, bodies.clone()) == bodies);
+            let multicore = std::thread::available_parallelism().is_ok_and(|it| it.get() > 1);
+            let expected = if multicore { (1, 1) } else { (2, 0) };
+            assert_eq!(DECLARATION_PREWARM_ROUTES.get(), expected);
+            assert!(prewarm_declaration_bodies(&db, small.clone()) == small);
+            assert_eq!(DECLARATION_PREWARM_ROUTES.get(), (expected.0 + 1, expected.1));
+        });
+        DECLARATION_PREWARM_ROUTES.set((0, 0));
+        assert_eq!(check_parallel_declared_query(&db, file, "large to single nested wave"), 1);
+        let routes = DECLARATION_PREWARM_ROUTES.get();
+        assert!(routes.0 > 0, "parent small/empty wave not routed");
+        if std::thread::available_parallelism().is_ok_and(|it| it.get() > 1) {
+            assert!(routes.1 > 0, "original parallel lower not routed");
+        }
+        let changed = source.replace(
+            "fn only_nested() {}",
+            "fn only_nested() { fn after_transition() {} static TRANSITION: u8 = 1; }",
+        );
+        assert_ne!(source, changed);
+        db.set_file_text_with_durability(file, &changed, Durability::LOW);
+        assert_eq!(check_parallel_declared_query(&db, file, "transition nested edit"), 1);
+        hir::attach_db(&db, || {
+            let krate =
+                hir::Semantics::new(&db).file_to_module_defs(file).next().unwrap().krate(&db);
+            let graph = parallel_crate_declarations(&db, krate.into());
+            assert!(
+                graph.functions.iter().any(|&id| {
+                    hir::Function::from(id).name(&db).as_str() == "after_transition"
+                })
+            );
+            assert_eq!(graph.statics.len(), 1);
+        });
+        db.set_file_text_with_durability(file, &source, Durability::LOW);
+        assert_eq!(check_parallel_declared_query(&db, file, "transition restored"), 1);
+    }
