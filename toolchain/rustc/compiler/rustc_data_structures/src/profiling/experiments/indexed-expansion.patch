+        (ledger, slot, Instant::now())
+    }))
+}
+
+impl Drop for JrExpansionGuard {
+    #[inline]
+    fn drop(&mut self) {
+        if let Some((ledger, slot, start)) = self.0 {
+            let elapsed = start.elapsed();
+            let mut rows = ledger.phases.lock();
+            if ledger.indexed_expansion {
+                rows.add_slot(slot, elapsed);
+            } else {
+                rows.add(slot.label(), elapsed);
+            }
+        }
+    }
+}
