 use crate::{DiagnosticsConfig, Severity};
 
+#[test]
+fn resident_selective_traversal_full_api_preserves_syntax_warnings() {
+    let (db, files) = RootDatabase::with_many_files(
+        r#"
+//- /lib.rs
+mod items { pub struct Thing { pub field: u32 } }
+use items::{Thing};
+fn selected(field: u32) -> Thing { Thing { field: field } }
+"#,
+    );
+    hir::attach_db(&db, || {
+        let config = DiagnosticsConfig::test_sample();
+        let resolve = AssistResolveStrategy::All;
+        let file_id = files[0].file_id(&db);
+        let full = super::full_diagnostics(&db, &config, &resolve, file_id);
+        assert!(full.iter().any(|d| d.code.as_str() == "unused_braces"));
+        assert!(full.iter().any(|d| d.code.as_str() == "redundant_field_names"));
+
+        let selective =
+            super::semantic_diagnostics_of_bodies(&db, &config, &resolve, file_id, None, &|_| true);
+        assert!(
+            selective
+                .iter()
+                .all(|d| { !matches!(d.code.as_str(), "unused_braces" | "redundant_field_names") })
+        );
+    });
+}
+
+#[test]
+fn resident_selective_traversal_all_bodies_matches_full_semantic_errors() {
+    let (db, files) = RootDatabase::with_many_files(
+        r#"
+//- /lib.rs
+fn first() -> u32 { true }
+fn second() -> bool { 42 }
+"#,
+    );
+    hir::attach_db(&db, || {
+        let config = DiagnosticsConfig::test_sample();
+        let resolve = AssistResolveStrategy::All;
+        let file_id = files[0].file_id(&db);
+        let full = super::semantic_diagnostics(&db, &config, &resolve, file_id);
+        let selective =
+            super::semantic_diagnostics_of_bodies(&db, &config, &resolve, file_id, None, &|_| true);
+        assert_eq!(full.iter().filter(|d| d.code.as_str() == "E0308").count(), 2);
+        // Debug includes the complete diagnostic, including fixes and main-node pointers.
+        assert_eq!(format!("{full:?}"), format!("{selective:?}"));
+    });
+}
+
+#[test]
+fn resident_selective_traversal_predicate_keeps_only_requested_body_errors() {
+    let (db, files) = RootDatabase::with_many_files(
+        r#"
+//- /lib.rs
+fn selected() -> u32 { true }
+fn skipped() -> bool { 42 }
+"#,
+    );
+    hir::attach_db(&db, || {
+        let config = DiagnosticsConfig::test_sample();
+        let resolve = AssistResolveStrategy::All;
+        let file_id = files[0].file_id(&db);
+        let full = super::semantic_diagnostics(&db, &config, &resolve, file_id);
+        let selected =
+            super::semantic_diagnostics_of_bodies(&db, &config, &resolve, file_id, None, &|body| {
+                body.name(&db).is_some_and(|name| name.as_str() == "selected")
+            });
+        let errors: Vec<_> = full.iter().filter(|d| d.code.as_str() == "E0308").collect();
+        assert_eq!(errors.len(), 2);
+        assert_eq!(selected.len(), 1);
+        assert_eq!(selected[0].code.as_str(), "E0308");
+        let text = db.file_text(file_id).text(&db);
+        let range = selected[0].range.range;
+        assert_eq!(&text[usize::from(range.start())..usize::from(range.end())], "true");
+        assert!(errors.iter().any(|d| format!("{d:?}") == format!("{:?}", selected[0])));
+        let none =
+            super::semantic_diagnostics_of_bodies(&db, &config, &resolve, file_id, None, &|_| {
+                false
+            });
+        assert!(none.is_empty());
+    });
+}
