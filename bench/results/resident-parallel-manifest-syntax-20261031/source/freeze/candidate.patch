+// Explicit mode for native fixtures, never mutate the process-cached flag in tests.
+fn read_fetched_parallel(
+    texts: &[String],
+    paths: &[PathBuf],
+    ctx: &Context,
+    enabled: bool,
+) -> Result<Option<Vec<Package>>> {
+    if !enabled
+        || texts.len() != paths.len()
+        || !texts.iter().all(|text| text.starts_with("registry+") || text.starts_with("sparse+"))
+    {
+        return Ok(None);
+    }
+    let parsed = {
+        let _syntax =
+            tracing::info_span!(target: "ra_jit::planning", "resolver fetched manifest syntax")
+                .entered();
+        blaze_manifest::manifest::preparse_manifests(paths)
+    };
+    let Some(parsed) = parsed else {
+        return Ok(None);
+    };
+    let _normalize =
+        tracing::info_span!(target: "ra_jit::planning", "resolver fetched manifest normalize")
+            .entered();
+    let mut read = Vec::with_capacity(texts.len());
+    for ((source_text, manifest_path), parsed) in texts.iter().zip(paths).zip(parsed) {
+        // Source/config errors still precede this manifest's syntax errors, and
+        // every earlier manifest's complete semantics still precedes this one.
+        let source = manifest_source(source_text, &ctx.config)?;
+        let EitherManifest::Real(manifest) = parsed.read(source, ctx)? else {
+            bail!("{} has no package", manifest_path.display());
+        };
+        read.push(Package {
+            manifest_path: manifest_path.clone(),
+            manifest,
+            locked_source: Some(source_text.clone()),
+        });
+    }
+    Ok(Some(read))
+}
