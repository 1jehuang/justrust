+#[test]
+fn balanced_scheduler_does_not_trap_adjacent_files_behind_slow_first_file() {
+    use std::sync::{Condvar, Mutex};
+    use std::time::Duration;
+
+    let fixture = Fixture::new();
+    let paths = fixture.paths();
+    let ready = (Mutex::new(false), Condvar::new());
+    let gathered = schedule_manifest_syntax(paths.len(), 2, |index| {
+        let bytes = std::fs::read(&paths[index]).unwrap();
+        if index == 0 {
+            // A fixed contiguous chunk would prevent index 1 from running until
+            // this wait expires. A second dynamic worker can claim it directly.
+            let (done, timeout) = ready
+                .1
+                .wait_timeout_while(ready.0.lock().unwrap(), Duration::from_secs(5), |done| !*done)
+                .unwrap();
+            assert!(*done && !timeout.timed_out(), "adjacent file stuck behind slow manifest");
+        } else if index == 1 {
+            *ready.0.lock().unwrap() = true;
+            ready.1.notify_all();
+        }
+        bytes
+    })
+    .expect("dynamic distribution must complete without a chunk dependency");
+    assert_eq!(gathered, paths.iter().map(|p| std::fs::read(p).unwrap()).collect::<Vec<_>>());
+}
