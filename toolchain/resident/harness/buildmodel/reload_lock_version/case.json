{
  "row": "reload: a dependency's version is bumped in `Cargo.lock`",
  "package": "app",
  "crates": [
    "app"
  ],
  "steps": [
    {
      "what": "the lock file has the newer version",
      "run": [
        "cargo update --quiet -p dep --precise 0.1.1"
      ]
    },
    {
      "what": "and the older again",
      "run": [
        "cargo update --quiet -p dep --precise 0.1.0"
      ]
    }
  ]
}
