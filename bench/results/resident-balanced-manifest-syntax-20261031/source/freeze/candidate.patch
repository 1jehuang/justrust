+#[test]
+#[cfg(panic = "unwind")]
+fn balanced_scheduler_joins_all_workers_before_panic_fallback() {
+    let fixture = Fixture::new();
+    let paths = fixture.paths();
+    let completed = AtomicUsize::new(0);
+    let result = schedule_manifest_syntax(paths.len(), 4, |index| {
+        if index == 0 {
+            panic!("controlled syntax worker failure, not a normal parse error");
+        }
+        let bytes = std::fs::read(&paths[index]).unwrap();
+        completed.fetch_add(1, Ordering::Relaxed);
+        bytes
+    });
+    assert!(result.is_none());
+    assert_eq!(completed.load(Ordering::Relaxed), paths.len() - 1);
+    // A failed speculative batch leaves normal fresh sequential parsing intact.
+    let expected = original_read_manifest(&paths[0], source(), &fixture.context());
+    let actual = read_manifest(&paths[0], source(), &fixture.context());
+    assert_eq!(snapshot(actual, &fixture.0), snapshot(expected, &fixture.0));
+}
