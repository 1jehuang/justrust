+                b"ra-jit entry 12".to_vec(),
+                program.map_or(Vec::new(), |p| p.to_vec()),
+                backend.to_vec(),
+            ];
+            if level != 0 {
+                fields.push(vec![b'M', level]);
+            }
+            fields.push(target.to_vec());
+            if frame {
+                fields.push(b"frame pointers".to_vec());
+            }
+            if dead {
+                fields.push(b"link dead code".to_vec());
+            }
+            fields.push(vec![(debug != Told::Nothing) as u8]);
+            if debug == Told::Lines {
+                fields.push(b"lines alone".to_vec());
+            }
+            fields.push(name.as_bytes().to_vec());
+            let mut bytes = Vec::new();
+            for field in fields {
+                bytes.extend_from_slice(&(field.len() as u64).to_le_bytes());
+                bytes.extend(field);
+            }
+            <[u8; KEY]>::from(Sha256::digest(bytes))
+        };
+        for program in [None, Some([19; 32])] {
+            for (backend, target) in
+                [(b"ab".as_slice(), b"c".as_slice()), (b"a", b"bc"), (b"", b"\0")]
