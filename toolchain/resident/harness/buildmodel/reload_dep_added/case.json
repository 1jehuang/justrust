{
  "row": "reload: a dependency is added to the manifest and removed again",
  "package": "app",
  "crates": [
    "app"
  ],
  "steps": [
    {
      "what": "a dependency is added",
      "edit": [
        [
          "app/Cargo.toml",
          "[dependencies]\n",
          "[dependencies]\nextra = { path = \"../extra\" }\n"
        ],
        [
          "app/src/main.rs",
          "\"alone\".to_owned()",
          "format!(\"with {}\", extra::name())"
        ]
      ]
    },
    {
      "what": "and removed",
      "edit": [
        [
          "app/Cargo.toml",
          "extra = { path = \"../extra\" }\n",
          ""
        ],
        [
          "app/src/main.rs",
          "format!(\"with {}\", extra::name())",
          "\"alone again\".to_owned()"
        ]
      ]
    }
  ]
}
