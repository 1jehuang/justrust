{
  "ripgrep": {
    "repo": "https://github.com/BurntSushi/ripgrep", "package": "ripgrep", "scrub": ["\"nanos\":\\d+", "[0-9.]+s\\b", "[0-9.]+ seconds"],
    "crates": ["rg", "globset", "grep", "grep_cli", "grep_matcher", "grep_printer", "grep_searcher", "grep_regex", "ignore"],
    "runs": [["--version"], ["--help"], ["-n", "fn main", "crates/core"], ["-c", "-i", "regex", "crates", "--sort", "path"],
             ["--json", "Searcher", "crates/searcher/src/lib.rs"], ["-o", "-w", "[A-Z][a-z]+Builder", "crates/printer/src", "--sort", "path"],
             ["--files", "crates/globset", "--sort", "path"], ["-U", "-C", "1", "impl Default[^{]*\\{\\n", "crates/matcher/src/lib.rs"],
             ["--stats", "-q", "unsafe", "crates", "-j", "1"], ["-t", "toml", "-F", "version", "--sort", "path"],
             ["--no-such-flag"], ["-e", "(unclosed", "crates"]]
  },
  "fd": {
    "repo": "https://github.com/sharkdp/fd", "package": "fd-find", "crates": ["fd"],
    "runs": [["--version"], ["--help"], ["-e", "rs", ".", "src", "-j", "1"], ["-t", "d", ".", "src", "-j", "1"],
             ["-g", "*.toml", "-j", "1"], ["walk", "src", "-x", "echo", "found", "-j", "1"], ["-S", "+10k", ".", "src", "-j", "1"],
             ["-d", "1", "-a", "-0", "main", "src"], ["--bad-flag"], ["[invalid", "src"]]
  },
  "bat": {
    "repo": "https://github.com/sharkdp/bat", "package": "bat", "cargo_args": ["--bin", "bat"], "crates": ["bat"],
    "runs": [["--version"], ["--help"], ["-p", "--color=never", "Cargo.toml"], ["--color=always", "-n", "src/lib.rs"],
             ["-A", "--color=never", "-r", "1:20", "src/main.rs"], ["--list-languages"], ["--list-themes", "--color=never"],
             ["--style=full", "--color=always", "--decorations=always", "--terminal-width=80", "-l", "rust", "src/pager.rs"],
             ["--diagnostic"], ["no-such-file"]]
  },
  "just": {
    "repo": "https://github.com/casey/just", "package": "just", "cargo_args": ["--bin", "just"], "crates": ["just"],
    "runs": [["--version"], ["--help"], ["--list"], ["--dump"], ["--dump", "--dump-format", "json"], ["--summary"],
             ["--evaluate"], ["--show", "test"], ["--dry-run", "check"], ["--justfile", "no-such-file", "--list"],
             ["no-such-recipe"], ["--fmt", "--check", "--unstable"]]
  },
  "hyperfine": {
    "repo": "https://github.com/sharkdp/hyperfine", "package": "hyperfine", "crates": ["hyperfine"],
    "runs": [["--version"], ["--help"], ["--runs", "0", "true"], ["--bad"], ["-N", "no-such-command-xyz"],
             ["--parameter-scan", "x", "1", "0", "echo {x}"], ["--min-runs", "x", "true"]]
  },
  "zoxide": {
    "repo": "https://github.com/ajeetdsouza/zoxide", "package": "zoxide", "crates": ["zoxide"],
    "runs": [["--version"], ["--help"], ["init", "bash"], ["init", "zsh", "--cmd", "j"], ["init", "fish", "--hook", "prompt"],
             ["init", "nushell"], ["init", "powershell"], ["query", "no-such-dir-xyz"], ["bogus"]]
  },
  "tokei": {
    "repo": "https://github.com/XAMPPRocky/tokei", "package": "tokei", "cargo_args": ["--bin", "tokei"], "crates": ["tokei"],
    "runs": [["--version"], ["--help"], ["src", "--sort", "code"], ["src", "--files", "--sort", "lines"], ["-l"], ["tests/data", "--sort", "code"], ["-t", "Rust", "src"], ["--bogus"]]
  }
}
