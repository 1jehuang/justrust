+
+    def invoke(group, phase, replicate, contents, touches=None):
+        nonlocal expected_tests
+        env = dict(environments[group])
+        segment = None if group == 'reference' else int(group[-1])
+        stack = 'reference' if segment is None else 'engine'
+        tool = tools[stack]
