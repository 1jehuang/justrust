+    for workers in 2..=4 {
+        let visits: Vec<_> = paths.iter().map(|_| AtomicUsize::new(0)).collect();
+        let gathered = schedule_manifest_syntax(paths.len(), workers, |index| {
+            visits[index].fetch_add(1, Ordering::Relaxed);
+            (index, std::fs::read(&paths[index]).unwrap())
+        })
+        .expect("bounded balanced batch");
+        for (expected_index, (index, bytes)) in gathered.into_iter().enumerate() {
+            assert_eq!(index, expected_index);
+            assert_eq!(bytes, std::fs::read(&paths[index]).unwrap());
+            assert_eq!(visits[index].load(Ordering::Relaxed), 1);
+        }
+    }
+    for workers in [0, 1, 5] {
+        assert!(schedule_manifest_syntax::<Vec<u8>>(paths.len(), workers, |_| {
