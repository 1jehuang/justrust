{
  "row": "reload: requests that arrive in the middle of one",
  "package": "app",
  "crates": [
    "app",
    "feat"
  ],
  "env": {
    "RA_JIT_RELOAD_PAUSE_MS": "3000"
  },
  "steps": [
    {
      "what": "8 clients ask while two features are turned on",
      "edit": [
        [
          "app/Cargo.toml",
          "features = []",
          "features = [\"loud\"]"
        ],
        [
          "app/Cargo.toml",
          "default = []",
          "default = [\"wide\"]"
        ]
      ],
      "clients": 8,
      "paused": true
    },
    {
      "what": "8 clients ask while one of them is turned off",
      "edit": [
        [
          "app/Cargo.toml",
          "features = [\"loud\"]",
          "features = []"
        ]
      ],
      "clients": 8,
      "paused": true
    }
  ]
}
