+/// Resolution is repeated in every relevant crate, and uncertain contexts fail closed.
+pub(crate) fn diagnostic_skeleton(
+    db: &RootDatabase,
+    file: FileId,
+    within: Option<&FxHashSet<ide_db::base_db::Crate>>,
+) -> Option<u64> {
