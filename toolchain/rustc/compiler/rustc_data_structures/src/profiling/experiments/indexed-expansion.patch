@@ -0,0 +1,85 @@
+use std::time::Duration;
+
+use super::FxHashMap;
+
+const LABELS: [&str; 6] = [
+    "expand_resolve_dollar_crates",
+    "expand_collect_invocations",
+    "expand_build_reduced_graph",
+    "expand_declarative_bang",
+    "expand_declarative_attr",
+    "expand_declarative_derive",
+];
+
+#[derive(Clone, Copy)]
+pub(super) struct JrExpansionSlot(usize);
+
+impl JrExpansionSlot {
+    #[inline(always)]
+    pub(super) fn for_label(label: &str) -> Self {
+        Self(LABELS.iter().position(|&name| name == label).expect("unknown expansion phase"))
+    }
+
+    pub(super) fn label(self) -> &'static str {
+        LABELS[self.0]
+    }
+}
+
+#[derive(Default)]
+pub(super) struct JrPhaseRows {
+    indexed: [(Duration, u64); LABELS.len()],
+    other: FxHashMap<&'static str, (Duration, u64)>,
+}
+
+impl JrPhaseRows {
+    #[inline]
+    pub(super) fn add_slot(&mut self, slot: JrExpansionSlot, duration: Duration) {
+        let entry = &mut self.indexed[slot.0];
+        entry.0 += duration;
+        entry.1 += 1;
+    }
+
+    #[inline]
+    pub(super) fn add(&mut self, label: &'static str, duration: Duration) {
+        let entry = self.other.entry(label).or_default();
+        entry.0 += duration;
+        entry.1 += 1;
+    }
+
+    /// A write is a snapshot, not a flush: a rearmed final write must retain all early rows.
+    pub(super) fn snapshot(&self) -> FxHashMap<&'static str, (Duration, u64)> {
+        let mut rows = self.other.clone();
+        for (label, (duration, count)) in LABELS.into_iter().zip(self.indexed) {
+            if count != 0 {
+                let entry = rows.entry(label).or_default();
+                entry.0 += duration;
+                entry.1 += count;
+            }
+        }
+        rows
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn early_and_rearmed_snapshots_match_map_exactly() {
+        let mut candidate = JrPhaseRows::default();
+        let mut reference = FxHashMap::default();
+        for i in 0..120 {
+            let label = LABELS[(i % 6) as usize];
+            let duration = Duration::from_nanos(i * 100000001);
+            let entry = reference.entry(label).or_insert((Duration::ZERO, 0));
+            entry.0 += duration;
+            entry.1 += 1;
+            if i % 7 == 0 {
+                candidate.add(label, duration);
+            } else {
+                candidate.add_slot(JrExpansionSlot::for_label(label), duration);
+            }
+            assert_eq!(candidate.snapshot(), reference);
+        }
+    }
+}
