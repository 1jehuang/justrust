# Mutable state reachable from published graph facts.
# Format: ROOT CARRIER PRIMITIVE  # witness path. ROOT is a type read or
# published as a graph fact. CARRIER is a type reachable from ROOT through
# fields, aliases or generic arguments that directly holds PRIMITIVE.
# Shrink-only forever: removing a line is progress, adding one requires
# explicit user approval. See GRAPH-INTEGRITY.md. Shrink after removal:
# GRAPH_INTEGRITY_SHRINK=1 justrust test --test graph_integrity
ConcreteProofFact PlanCtx Mutex  # ConcreteProofFact -> ConcreteCfg -> ClosedCfg -> Function -> GeneratedCfgShape -> CanonicalSourcePublication -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
ConcreteProofFact SchemaAdapter Mutex  # ConcreteProofFact -> ConcreteCfg -> ClosedCfg -> ValidatedFacts -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
Function PlanCtx Mutex  # Function -> GeneratedCfgShape -> CanonicalSourcePublication -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
Function SchemaAdapter Mutex  # Function -> GeneratedCfgShape -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
InstanceBodyFact PlanCtx Mutex  # InstanceBodyFact -> CheckedFunction -> BodySubstitutionProof -> VerifiedTemplateCfg -> CarrierEffectProof -> Function -> GeneratedCfgShape -> CanonicalSourcePublication -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
InstanceBodyFact SchemaAdapter Mutex  # InstanceBodyFact -> ValidatedFacts -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
ParsedProgram PlanCtx Mutex  # ParsedProgram -> Program -> Function -> GeneratedCfgShape -> CanonicalSourcePublication -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
ParsedProgram SchemaAdapter Mutex  # ParsedProgram -> Program -> Function -> GeneratedCfgShape -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
PlanCtx PlanCtx Mutex  # PlanCtx -> Mutex
PlanCtx SchemaAdapter Mutex  # PlanCtx -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
PlanFact PlanCtx Mutex  # PlanFact -> Plan -> CarrierEffects -> CallCarrierBinding -> ValidatedCallEvidence -> ValidatedOriginalCalls -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
PlanFact SchemaAdapter Mutex  # PlanFact -> Plan -> ValidatedFacts -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
Program PlanCtx Mutex  # Program -> Function -> GeneratedCfgShape -> CanonicalSourcePublication -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
Program SchemaAdapter Mutex  # Program -> Function -> GeneratedCfgShape -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
TemplateBodyFact PlanCtx Mutex  # TemplateBodyFact -> CanonicalSourcePublication -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
TemplateBodyFact SchemaAdapter Mutex  # TemplateBodyFact -> CanonicalSourcePublication -> ValidatedFacts -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
TemplateCfg PlanCtx Mutex  # TemplateCfg -> Function -> GeneratedCfgShape -> CanonicalSourcePublication -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
TemplateCfg SchemaAdapter Mutex  # TemplateCfg -> ValidatedFacts -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
UniversalProofFact PlanCtx Mutex  # UniversalProofFact -> VerifiedTemplateCfg -> CarrierEffectProof -> Function -> GeneratedCfgShape -> CanonicalSourcePublication -> OriginalBody -> OriginalSource -> PlanCtx -> Mutex
UniversalProofFact SchemaAdapter Mutex  # UniversalProofFact -> VerifiedTemplateCfg -> CarrierEffectProof -> ValidatedFacts -> ValidatedTraitWorld -> dyn SchemaCx -> SchemaAdapter -> Mutex
