+/// A local database extension exposes the existing safe typed clone without
+/// downcasting a Salsa trait object. Clones share storage, never mutate inputs,
+/// and do not transfer their query reads to the parent's dependency stack.
+#[salsa::db]
+trait DeclarationDatabase: HirDatabase {
+    fn declaration_snapshot(&self) -> RootDatabase;
+}
+
+#[salsa::db]
+impl DeclarationDatabase for RootDatabase {
+    fn declaration_snapshot(&self) -> RootDatabase {
+        self.clone()
+    }
+}
+
+#[cfg(test)]
+thread_local! {
+    // Actual provider entries on the requesting thread, not wrapper calls or hits.
+    static PARALLEL_DECLARED_QUERY_PROVIDERS: std::cell::Cell<usize> = const {
+        std::cell::Cell::new(0)
+    };
+}
+
+/// Native final graph with the original wave ordering and parallel cold lowering.
+#[salsa::tracked(returns(ref))]
+fn parallel_crate_declarations(
+    db: &dyn DeclarationDatabase,
+    krate: ide_db::base_db::Crate,
+) -> Declared {
+    #[cfg(test)]
+    PARALLEL_DECLARED_QUERY_PROVIDERS.set(PARALLEL_DECLARED_QUERY_PROVIDERS.get() + 1);
+    // A process-once witness of provider entry only. Failed stderr writes are ignored.
+    static FIRST_PROVIDER: std::sync::Once = std::sync::Once::new();
+    FIRST_PROVIDER.call_once(|| {
+        use std::io::Write;
+        let _ = writeln!(
+            std::io::stderr().lock(),
+            "parallel-declared-query-provider-entry pid={}",
+            std::process::id()
+        );
+    });
+    hir_def::nameres::crate_def_map(db, krate);
+    let mut declared = module_declarations(db, krate).clone();
+    let snapshot = db.declaration_snapshot();
+    while !declared.bodies.is_empty() || !declared.provided.is_empty() {
+        for under_provided in [false, true] {
+            let bodies = if under_provided {
+                std::mem::take(&mut declared.provided)
+            } else {
+                std::mem::take(&mut declared.bodies)
+            };
+            // Warm actual Body::of queries using the unmodified original scheduler.
+            // Every fragment is then read on db, not snapshot: these mandatory reads
+            // record the complete dependency edges of this tracked parent query.
+            for body in lower(&snapshot, bodies) {
+                declared.extend(body_declarations(db, body, under_provided));
+            }
+        }
+    }
+    declared
 }
 
