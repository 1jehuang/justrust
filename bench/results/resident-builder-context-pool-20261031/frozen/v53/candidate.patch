+fn builder_pool_flag(value: Option<&std::ffi::OsStr>) -> bool {
+    value == Some(std::ffi::OsStr::new("1"))
+}
+
+fn builder_pool_enabled() -> bool {
+    static ENABLED: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| {
+        builder_pool_flag(std::env::var_os("RA_JIT_BUILDER_POOL").as_deref())
+    });
+    *ENABLED
+}
+
+#[derive(Default)]
+struct BuilderPool {
+    available: Option<FunctionBuilderContext>,
+    announced: bool,
+    #[cfg(test)]
+    reused: usize,
+    #[cfg(test)]
+    returned: usize,
+}
+
+thread_local! {
+    static BUILDER_POOL: std::cell::RefCell<BuilderPool> = Default::default();
+}
+
+fn take_builder_context(enabled: bool) -> FunctionBuilderContext {
+    if enabled {
+        let cached = BUILDER_POOL.try_with(|pool| {
+            let mut pool = pool.try_borrow_mut().ok()?;
+            let cached = pool.available.take();
+            #[cfg(test)]
+            if cached.is_some() {
+                pool.reused += 1;
+            }
+            let announce = cached.is_some() && !pool.announced;
+            pool.announced |= announce;
+            Some((cached, announce))
+        });
+        if let Ok(Some((Some(context), announce))) = cached {
+            if announce {
+                static ANNOUNCED: std::sync::Once = std::sync::Once::new();
+                ANNOUNCED.call_once(|| {
+                    use std::io::Write as _;
+                    let _ = std::io::stderr().write_all(b"resident: builder-context-pool reused\n");
+                });
+            }
+            return context;
+        }
+    }
+    FunctionBuilderContext::new()
+}
+
+// Only call after finalize has returned and the builder's enclosing scope ended.
+// No Drop guard: errors, unwinding and incomplete builders must discard their arenas.
+fn return_finalized_builder_context(enabled: bool, context: FunctionBuilderContext) {
+    if enabled {
+        let _ = BUILDER_POOL.try_with(|pool| {
+            let Ok(mut pool) = pool.try_borrow_mut() else { return };
+            if pool.available.is_none() {
+                pool.available = Some(context);
+                #[cfg(test)]
+                {
+                    pool.returned += 1;
+                }
+            }
+        });
+    }
+}
