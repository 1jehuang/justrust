+// Exact first-use opt-in. No environment mutation or caching of filesystem proofs.
+fn warm_registry_fetch_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| {
