+/// Hash the complete syntax text exactly as an owned string, reusing only its storage.
+fn diagnostic_text_hash(text: syntax::SyntaxText, scratch: &mut String) -> u64 {
+    use std::hash::BuildHasher as _;
+    scratch.clear();
+    text.for_each_chunk(|chunk| scratch.push_str(chunk));
+    rustc_hash::FxBuildHasher.hash_one(scratch.as_str())
+}
