{
  "row": "reload: a feature is toggled in the manifest",
  "package": "app",
  "crates": [
    "app",
    "feat"
  ],
  "steps": [
    {
      "what": "a feature of a dependency is turned on",
      "edit": [
        [
          "app/Cargo.toml",
          "features = []",
          "features = [\"loud\"]"
        ]
      ],
      "clients": 6
    },
    {
      "what": "a default feature of the package is turned on",
      "edit": [
        [
          "app/Cargo.toml",
          "default = []",
          "default = [\"wide\"]"
        ]
      ],
      "clients": 6
    },
    {
      "what": "and both off",
      "edit": [
        [
          "app/Cargo.toml",
          "features = [\"loud\"]",
          "features = []"
        ],
        [
          "app/Cargo.toml",
          "default = [\"wide\"]",
          "default = []"
        ]
      ],
      "clients": 6
    }
  ]
}
