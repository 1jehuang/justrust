+    // Frozen pre-cursor DFS. Keep independent of the production adjacency selector so
+    // native fixtures compare settlement and counters, not just a model of the graph.
+    fn original_usable(this: &Entries, name: &str, defines: &dyn Fn(&str) -> bool) -> bool {
+        let settled = |name: &str| this.usable.shard(name).get(name).copied();
+        if let Some(usable) = settled(name) {
+            this.count(if usable { Miss::SettledPositive } else { Miss::SettledNegative });
+            return usable;
+        }
+        let name: Arc<str> = Arc::from(name);
+        let Some(entry) = this.get(&name).filter(|it| {
+            let links = it.links(defines);
+            if !links {
+                this.count(Miss::NativeImports);
+            }
+            links
+        }) else {
+            this.count(Miss::DirectUnavailable);
+            this.settle(name, false);
+            return false;
+        };
+        let mut unsettled = vec![name.clone()];
+        let mut leaning = FxHashMap::<Arc<str>, usize>::default();
+        leaning.insert(name.clone(), 0);
+        let mut path = vec![Visit { name, entry, seen: 0, leans_on: 0, below: 0 }];
+        while !path.is_empty() {
+            let depth = path.len() - 1;
+            let visit = &mut path[depth];
+            let entry = visit.entry.clone();
+            let Some(callee) = entry.named().nth(visit.seen) else {
+                let Some(done) = path.pop() else { break };
+                if done.leans_on >= depth {
+                    for name in unsettled.drain(done.below..) {
+                        leaning.remove(&name);
+                        this.settle(name, true);
+                    }
+                } else {
+                    leaning.insert(done.name, done.leans_on);
+                    let above = &mut path[depth - 1];
+                    above.leans_on = above.leans_on.min(done.leans_on);
+                }
+                continue;
+            };
+            visit.seen += 1;
+            if let Some(&on) = leaning.get(callee) {
+                visit.leans_on = visit.leans_on.min(on);
+                continue;
+            }
+            let found = match settled(callee) {
+                Some(true) => {
+                    this.count(Miss::DependencySettledPositive);
+                    continue;
+                }
+                Some(false) => {
+                    this.count(Miss::DependencySettledNegative);
+                    None
+                }
+                None => {
+                    let found = this.get(callee);
+                    if found.is_none() {
+                        this.count(Miss::DependencyUnavailable);
+                    }
+                    found.filter(|it| {
+                        let links = it.links(defines);
+                        if !links {
+                            this.count(Miss::DependencyNativeImports);
+                        }
+                        links
+                    })
+                }
+            };
+            let callee: Arc<str> = Arc::from(callee);
+            let Some(entry) = found else {
+                this.count(Miss::TransitiveFailure);
+                this.settle(callee, false);
+                for visit in path {
+                    this.settle(visit.name, false);
+                }
+                return false;
+            };
+            leaning.insert(callee.clone(), depth + 1);
+            unsettled.push(callee.clone());
+            path.push(Visit {
+                name: callee,
+                entry,
+                seen: 0,
+                leans_on: depth + 1,
+                below: unsettled.len() - 1,
+            });
+        }
+        this.count(Miss::UsablePositive);
+        true
+    }
