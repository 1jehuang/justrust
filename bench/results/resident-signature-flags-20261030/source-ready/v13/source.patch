+#[cfg(test)]
+mod resident_signature_flag_tests {
+    use super::*;
+    use crate::{
+        AssocItemId, ModuleDefId,
+        nameres::{
+            assoc::{ImplItems, TraitItems},
+            crate_def_map,
+        },
+        test_db::TestDB,
+    };
+    use test_fixture::WithFixture;
+
+    fn functions(db: &TestDB) -> Vec<FunctionId> {
+        let mut functions = Vec::new();
+        let map = crate_def_map(db, db.test_crate());
+        for (_, module) in map.modules(db) {
+            let scope = module.scope(db);
+            for item in scope.declarations() {
+                match item {
+                    ModuleDefId::FunctionId(id) => functions.push(id),
+                    ModuleDefId::TraitId(id) => {
+                        for (_, item) in &TraitItems::query(db, id).items {
+                            if let AssocItemId::FunctionId(id) = item {
+                                functions.push(*id);
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            for id in scope.impls() {
+                for (_, item) in &ImplItems::of(db, id).0.items {
+                    if let AssocItemId::FunctionId(id) = item {
+                        functions.push(*id);
+                    }
+                }
+            }
+        }
+        functions
+    }
+
+    #[test]
+    fn resident_signature_comptime_matches_direct_attributes_across_revisions() {
+        // Both true and false cfg predicates are independent of fixture defaults.
+        let fixture = r#"
+fn plain() { let _ = 1; }
+#[rustc_comptime]
+fn bare() {}
+#[cfg_attr(all(), rustc_comptime)]
+fn enabled() {}
+#[cfg_attr(any(), rustc_comptime)]
+fn disabled() {}
+#[cfg_attr(all(), cfg_attr(all(), rustc_comptime))]
+fn nested() {}
+#[rustc_comptime()]
+fn tokens() {}
+#[rustc_comptime = "yes"]
+fn value() {}
+#[other::rustc_comptime]
+fn qualified() {}
+trait Tr {
+    #[rustc_comptime]
+    fn required();
+    #[cfg_attr(all(), rustc_comptime)]
+    fn provided() {}
+}
+struct S;
+impl S { #[rustc_comptime] fn inherent() {} }
+impl Tr for S { #[rustc_comptime] fn required() {} }
+"#;
+        let (mut db, file) = TestDB::with_single_file(fixture);
+        let file = file.file_id(&db);
+        let revisions = [
+            fixture.to_owned(),
+            fixture.replace("let _ = 1", "let _ = 2"),
+            fixture.replace("fn plain()", "#[rustc_comptime]\nfn plain()"),
+            fixture.replace("#[rustc_comptime]", ""),
+            fixture.replace("cfg_attr(all(),", "cfg_attr(any(),"),
+            fixture.replace("#[rustc_comptime()]", "#[rustc_comptime]"),
+            fixture.replace("#[rustc_comptime = \"yes\"]", "#[rustc_comptime]"),
+            fixture.to_owned(),
+        ];
+        let mut baseline = Vec::new();
+        for (revision, text) in revisions.iter().enumerate() {
+            db.set_file_text(file, text);
+            let ids = functions(&db);
+            assert_eq!(ids.len(), 12, "fixture must exercise every container");
+            for id in ids {
+                // Read the cached result FIRST. Never replace this oracle with the
+                // signature flag or the codegen helper that consumes that flag.
+                let signature = FunctionSignature::of(&db, id).clone();
+                let cached = signature.flags.contains(FnFlags::RUSTC_COMPTIME);
+                let original = AttrFlags::has_word(&db, id.into(), "rustc_comptime");
+                assert_eq!(cached, original, "revision {revision}: {:?}", signature.name);
+                if revision == 0 {
+                    let name = signature.name.as_str();
+                    assert_eq!(
+                        original,
+                        matches!(
+                            name,
+                            "bare" | "enabled" | "nested" | "required" | "provided" | "inherent"
+                        )
+                    );
+                    baseline.push((id, signature));
+                } else if revision == 1 {
+                    let before = &baseline.iter().find(|(old, _)| *old == id).unwrap().1;
+                    assert_eq!(before, &signature, "body-only edit changed signature");
+                }
+            }
+        }
+    }
+}
