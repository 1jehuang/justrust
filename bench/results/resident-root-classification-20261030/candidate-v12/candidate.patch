+    #[test]
+    fn resident_root_classification_reuses_providers_after_body_only_edits() {
+        use test_fixture::WithFixture;
+        let source = "fn main() { let _ = 1; }\nfn generic<T>() {}";
+        let (mut db, file) = RootDatabase::with_single_file(source);
+        let file = file.file_id(&db);
+        CLASSIFICATION_EXECUTIONS.with(|count| count.set([0; 3]));
+        let mut executions = None;
+        for (revision, source) in
+            [source.to_owned(), source.to_owned(), source.replace("= 1", "= 2")]
+                .into_iter()
+                .enumerate()
+        {
+            db.set_file_text_with_durability(
+                file,
+                &source,
+                ide_db::base_db::salsa::Durability::LOW,
+            );
+            hir::attach_db(&db, || {
+                let krate =
+                    hir::Semantics::new(&db).file_to_module_defs(file).next().unwrap().krate(&db);
+                let listed = ListedCrate::new(&db, krate);
+                assert_original_classification(&db, krate, &listed);
+                let count = CLASSIFICATION_EXECUTIONS.with(|count| count.get());
+                eprintln!("classification revision {revision}: [export, root, main] = {count:?}");
+                assert!(count.iter().all(|&it| it > 0), "cold fixture must execute every provider");
+                if let Some(previous) = executions {
+                    if revision == 1 {
+                        assert_eq!(count, previous, "unchanged repeat must reuse every provider");
+                    } else {
+                        // The native compile_time_only primitive may reexecute its raw
+                        // attribute read, but its unchanged boolean must backdate so all
+                        // three downstream classification providers stay green.
+                        assert_eq!(
+                            count, previous,
+                            "body edit must reuse export, root and main providers"
+                        );
+                    }
+                } else {
+                    assert_eq!(count, [2, 2, 1], "count the full cold classification demand");
+                }
+                executions = Some(count);
+            });
+        }
+    }
