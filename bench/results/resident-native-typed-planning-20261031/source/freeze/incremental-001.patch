+/// Licensed Blaze-derived v83 path: typed exported packages through summaries to programs.
+/// Original `programs` and `described` deliberately remain independent JSON oracles.
+pub fn programs_native_typed(asked: &Asked<'_>, targets: Targets<'_>) -> Result<Vec<Program>> {
+    if !native_typed_planning_enabled() {
+        return Ok(programs(asked, targets)?.1);
+    }
+    programs_native_typed_inner(asked, targets)
+}
+
+fn programs_native_typed_inner(asked: &Asked<'_>, targets: Targets<'_>) -> Result<Vec<Program>> {
+    anyhow::ensure!(asked.build.is_some(), "the programs are of a build");
+    resolving_with_mode(asked, None, None, true, |resolved, serialized, ids, _| {
+        let _projection =
+            tracing::info_span!(target: "ra_jit::planning", "resolver typed program projection")
+                .entered();
+        let kinds = match &asked.platform {
+            Some(p) => vec![CompileKind::Target(InternedString::new(p.triple))],
+            None => vec![CompileKind::Host],
+        };
+        let packages =
+            Packages { reads: resolved.packages, platform: asked.platform.as_ref(), host: None };
+        let FeatureRoots { specs, members } = resolved.one_feature_resolve()?;
+        let opts = FeatureOpts::new(resolved.behavior, resolved.has_dev_units, ForceAllTargets::No);
+        let features =
+            FeatureResolver::resolve(&packages, resolved.resolve, &members, &kinds, opts)?;
+        let roots = resolved.selected_ids(&specs);
+        let activated = |p: &Platform| packages.activates(p);
+        let graph = graph::of_build(
+            resolved.resolve,
+            &features,
+            &roots,
+            asked.build.as_ref().expect("checked build").dev_units,
+            resolved.packages,
+            &activated,
+            resolved.members.current,
+        )?;
+        let reached: FxHashMap<PackageId, usize> =
+            ids.iter().enumerate().map(|(at, id)| (*id, at)).collect();
+        let mut listed = Vec::new();
+        for node in &graph.nodes {
+            let id = ids
+                .iter()
+                .find(|id| id.to_spec() == node.id)
+                .copied()
+                .with_context(|| format!("no package {} was read", node.id))?;
+            listed.push((id, reached[&id]));
+        }
+        listed.sort();
+        let unharnessed: Vec<PathBuf> = resolved
+            .ws
+            .members()
+            .flat_map(|(_, m)| &m.targets)
+            .filter(|t| !t.harness)
+            .filter_map(|t| t.src_path.clone())
+            .collect();
+        let mut programs = Vec::new();
+        for (id, at) in listed {
+            if !roots.contains(&id) {
+                continue;
+            }
+            let package = serialized[at].planning();
+            let spec = id.to_spec();
+            let on: Vec<&str> = graph
+                .nodes
+                .iter()
+                .find(|n| n.id == spec)
+                .into_iter()
+                .flat_map(|n| &n.features)
+                .map(|f| f.as_str())
+                .collect();
+            let id = spec.to_string();
+            let mut integration = false;
+            let mut bins = Vec::new();
+            for target in package.targets {
+                let of = |name: &str| target.planning_kind(name);
+                let types = target.planning_types();
+                let only_bin = types.len() == 1 && types[0].as_str() == "bin";
+                let kind = match () {
+                    _ if of("bin") && only_bin => Kind::Bin,
+                    _ if of("example") && only_bin => Kind::Example,
+                    _ if of("test") => Kind::Test,
+                    _ if of("bench") || of("example") => continue,
+                    _ if of("custom-build") => continue,
+                    _ => Kind::Lib,
+                };
+                let kinds: Vec<Kind> = match (kind, targets.test) {
+                    (Kind::Lib, None) => [
+                        ("cdylib", Kind::Cdylib),
+                        ("staticlib", Kind::Staticlib),
+                        ("dylib", Kind::Dylib),
+                    ]
+                    .into_iter()
+                    .filter(|(s, _)| types.iter().any(|t| t.as_str() == *s))
+                    .map(|(_, k)| k)
+                    .collect(),
+                    _ => vec![kind],
+                };
+                let name = target.planning_name();
+                let root = target.planning_path().to_owned();
+                let missing: Vec<&str> = target
+                    .planning_required()
+                    .iter()
+                    .map(String::as_str)
+                    .filter(|s| !s.contains('/') && !on.contains(s))
+                    .collect();
+                if kind == Kind::Bin && missing.is_empty() {
+                    bins.push((name, root.clone()));
+                }
+                for kind in kinds {
+                    let Some(test) = targets.picks(kind, name, target.planning_test()) else {
+                        continue;
+                    };
+                    if !missing.is_empty() && targets.named() {
+                        let listed: Vec<String> =
+                            missing.iter().map(|s| format!("`{s}`")).collect();
+                        bail!(
+                            "target `{name}` in package `{}` requires the features: {}\nConsider enabling them by passing, e.g., `--features=\"{}\"`",
+                            package.name,
+                            listed.join(", "),
+                            missing.join(" ")
+                        );
+                    }
+                    if missing.is_empty() {
+                        integration |= kind == Kind::Test;
+                        let harness = test && !unharnessed.contains(&root);
+                        programs.push(Program {
+                            package: id.clone(),
+                            name: name.to_owned(),
+                            root: root.clone(),
+                            kind,
+                            test,
+                            harness,
+                        });
+                    }
+                }
+            }
+            for (name, root) in bins.into_iter().filter(|_| integration) {
+                programs.push(Program {
+                    package: id.clone(),
+                    name: name.to_owned(),
+                    root,
+                    kind: Kind::Bin,
+                    test: false,
+                    harness: false,
+                });
+            }
+        }
+        Ok(programs)
+    })
+}
