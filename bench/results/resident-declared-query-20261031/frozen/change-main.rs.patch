+fn crate_declarations(db: &dyn HirDatabase, krate: ide_db::base_db::Crate) -> Declared {
+    #[cfg(test)]
+    DECLARED_QUERY_PROVIDERS.set(DECLARED_QUERY_PROVIDERS.get() + 1);
+    // This marker witnesses provider entry, NOT a cache hit or successful completion.
+    // Ignoring I/O errors must not alter declaration discovery or cancellation.
+    static FIRST_PROVIDER: std::sync::Once = std::sync::Once::new();
+    FIRST_PROVIDER.call_once(|| {
+        if let Some(path) = std::env::var_os("RA_JIT_DECLARED_QUERY_MARKER") {
+            use std::io::Write;
+            if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+                let _ = writeln!(file, "declared-query-provider-entry pid={}", std::process::id());
+            }
+        }
+    });
+    hir_def::nameres::crate_def_map(db, krate);
+    let mut declared = module_declarations(db, krate).clone();
+    while !declared.bodies.is_empty() || !declared.provided.is_empty() {
+        for under_provided in [false, true] {
+            let bodies = if under_provided {
+                std::mem::take(&mut declared.provided)
+            } else {
+                std::mem::take(&mut declared.bodies)
+            };
+            for body in bodies {
+                declared.extend(body_declarations(db, body, under_provided));
