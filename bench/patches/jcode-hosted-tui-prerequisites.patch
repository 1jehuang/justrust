+    // SSH fixtures mutate this process-global setting under lock_test_env.
+    // Hold that same lock through dispatch, restoring even after a panic.
+    struct LocalEnvironment {
+        previous: Option<std::ffi::OsString>,
+        _lock: std::sync::MutexGuard<'static, ()>,
+    }
+
+    impl Drop for LocalEnvironment {
+        fn drop(&mut self) {
+            match self.previous.take() {
+                Some(value) => crate::env::set_var("JCODE_SSH_REMOTE", value),
+                None => crate::env::remove_var("JCODE_SSH_REMOTE"),
+            }
+        }
+    }
+
+    fn local_environment() -> LocalEnvironment {
+        let lock = lock_shared_state();
+        let previous = std::env::var_os("JCODE_SSH_REMOTE");
+        crate::env::remove_var("JCODE_SSH_REMOTE");
+        LocalEnvironment { previous, _lock: lock }
+    }
+
     #[test]
     fn colors_lists_every_role_with_its_hex_value() {
+        let _local = local_environment();
         let mut app = create_test_app();
