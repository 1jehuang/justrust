+// This separate diagnostic identity executes both selectors. Never time it as a speedup.
+#[cfg(feature = "native-adjacency-diagnostic")]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+struct AdjacencyDiagnostic {
+    selector_calls: u64,
+    yielded: u64,
+    visits: u64,
+    raw_lengths: u64,
+    max_raw_length: usize,
+    fanout: [u64; 8],
+    exhausted: u64,
+    candidate_inspections: u64,
+    original_inspections: u64,
+}
+
+#[cfg(all(test, feature = "native-adjacency-diagnostic"))]
+thread_local! {
+    static LAST_ADJACENCY_DIAGNOSTIC: std::cell::Cell<Option<AdjacencyDiagnostic>> = const { std::cell::Cell::new(None) };
+}
+
+#[cfg(feature = "native-adjacency-diagnostic")]
+impl AdjacencyDiagnostic {
+    fn admit(&mut self, entry: &Entry) {
+        let len = entry.funcs.len();
+        self.visits += 1;
+        self.raw_lengths += len as u64;
+        self.max_raw_length = self.max_raw_length.max(len);
+        let bucket = match len {
+            0 => 0,
+            1 => 1,
+            2..=7 => 2,
+            8..=31 => 3,
+            32..=127 => 4,
+            128..=511 => 5,
+            512..=2047 => 6,
+            _ => 7,
+        };
+        self.fanout[bucket] += 1;
+    }
+
+    fn select<'a>(
+        &mut self,
+        entry: &'a Entry,
+        seen: &mut usize,
+        named_seen: &mut usize,
+    ) -> Option<&'a str> {
+        self.selector_calls += 1;
+        // Count the raw inspections before filtering, including failed exhaustion scans.
+        // This is the original nth algorithm, not a formula estimating its work.
+        let original = entry
+            .funcs
+            .iter()
+            .inspect(|_| self.original_inspections += 1)
+            .filter_map(|func| match &func.target {
+                CachedTarget::Named(name) => Some(name.as_str()),
+                _ => None,
+            })
+            .nth(*named_seen);
+        let candidate = entry.funcs[*seen..].iter().find_map(|func| {
+            self.candidate_inspections += 1;
+            *seen += 1;
+            match &func.target {
+                CachedTarget::Named(name) => Some(name.as_str()),
+                _ => None,
+            }
+        });
+        assert_eq!(candidate, original, "native-adjacency-dual-v51 selector mismatch");
+        if candidate.is_some() {
+            *named_seen += 1;
+            self.yielded += 1;
+        } else {
+            self.exhausted += 1;
+        }
+        candidate
+    }
+}
+
+#[cfg(feature = "native-adjacency-diagnostic")]
+impl AdjacencyDiagnostic {
+    fn report(self) {
+        if self.visits == 0 {
+            return;
+        }
+        #[cfg(test)]
+        LAST_ADJACENCY_DIAGNOSTIC.with(|last| last.set(Some(self)));
+        // Fixed-size aggregate, no names, no per-edge events or shared counter atomics.
+        // Ignore reporting failure so diagnostics do not turn successful builds into errors.
+        use std::io::Write;
+        let _ = writeln!(
+            std::io::stderr().lock(),
+            "native-adjacency-dual-v51 timings_invalid=true selector_calls={} yielded={} visits={} raw_lengths={} max_raw_length={} fanout={:?} exhausted={} aborted={} candidate_inspections={} original_inspections={}",
+            self.selector_calls,
+            self.yielded,
+            self.visits,
+            self.raw_lengths,
+            self.max_raw_length,
+            self.fanout,
+            self.exhausted,
+            self.visits - self.exhausted,
+            self.candidate_inspections,
+            self.original_inspections
+        );
+    }
+}
