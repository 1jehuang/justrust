+/// The native planning experiment is latched on first use, with exact `1` as its only opt-in.
+pub fn native_typed_planning_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED
