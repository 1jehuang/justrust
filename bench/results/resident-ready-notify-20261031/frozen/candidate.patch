 /// How often a worker that is loading is looked at.
 const POLL: Duration = Duration::from_millis(20);
 
+/// Daemon-local experiment, latched before the serving threads start. Only exact `1`
+/// enables it, with no client or worker request protocol change.
+fn ready_notify() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("RA_JIT_READY_NOTIFY").is_some_and(|it| it == "1"))
+}
+
+/// Owned by one worker and used only with that worker's checkouts mutex.
+#[derive(Default)]
+struct ReadyNotify(Condvar);
+
+impl ReadyNotify {
+    fn loading(checkouts: &FxHashMap<String, Loaded>, key: &str, generation: u128) -> bool {
+        checkouts.get(key).is_some_and(|it| {
+            it.generation == generation && matches!(it.warmth, Warmth::Loading(_))
+        })
+    }
+
+    fn set(
+        &self,
+        checkouts: &Mutex<FxHashMap<String, Loaded>>,
+        key: &str,
+        generation: u128,
+        warmth: Warmth,
+        notify: bool,
+    ) {
+        let changed = {
+            let mut checkouts = lock(checkouts);
+            match checkouts.get_mut(key) {
+                Some(loaded) if loaded.generation == generation => {
+                    loaded.warmth = warmth;
+                    true
+                }
+                _ => false,
+            }
+        };
+        // Publish under the predicate mutex, then wake every build waiting on this worker.
+        if changed && notify {
+            self.0.notify_all();
+        }
+    }
+
+    fn wait(
+        &self,
+        checkouts: MutexGuard<'_, FxHashMap<String, Loaded>>,
+        key: &str,
+        generation: u128,
+        patience: Duration,
+    ) -> bool {
+        let loading = Self::loading(&checkouts, key, generation);
+        let (checkouts, timeout) = self
+            .0
+            .wait_timeout_while(checkouts, patience, |it| Self::loading(it, key, generation))
+            .unwrap_or_else(PoisonError::into_inner);
+        let transitioned = loading
+            && !timeout.timed_out()
+            && checkouts.get(key).is_some_and(|it| {
+                it.generation == generation && !matches!(it.warmth, Warmth::Loading(_))
+            });
+        drop(checkouts);
+        if transitioned && ready_notify() {
+            static NOTED: AtomicBool = AtomicBool::new(false);
+            if !NOTED.swap(true, Relaxed) {
+                let _ = writeln!(
+                    std::io::stderr().lock(),
+                    "ra-jit ready-notify: observed loading transition"
+                );
+            }
+        }
+        timeout.timed_out()
+    }
+}
