+    fn resident_signature_flags_functions(db: &RootDatabase, krate: Crate) -> Vec<FunctionId> {
+        let mut functions = Vec::new();
+        let map = hir_def::nameres::crate_def_map(db, krate.into());
+        for (_, module) in map.modules(db) {
+            let scope = module.scope(db);
+            for item in scope.declarations() {
+                match item {
+                    ModuleDefId::FunctionId(id) => functions.push(id),
+                    ModuleDefId::TraitId(id) => {
+                        for (_, item) in &id.trait_items(db).items {
+                            if let AssocItemId::FunctionId(id) = item {
+                                functions.push(*id);
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            for id in scope.impls() {
+                for (_, item) in &id.impl_items(db).items {
+                    if let AssocItemId::FunctionId(id) = item {
+                        functions.push(*id);
+                    }
+                }
+            }
+        }
+        functions
+    }
