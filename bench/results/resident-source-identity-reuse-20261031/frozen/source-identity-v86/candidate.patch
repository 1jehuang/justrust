+
+fn source_identity_reuse_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("RA_JIT_SOURCE_ID_REUSE").is_some_and(|v| v == "1"))
+}
+
+#[derive(Default)]
+struct SourceIdentityReuse {
+    successful: FxHashMap<String, blaze_manifest::source::SourceId>,
+    hits: usize,
+}
+
+impl SourceIdentityReuse {
+    fn resolve(
+        &mut self,
+        source: &str,
+        config: &Config,
+    ) -> Result<blaze_manifest::source::SourceId> {
+        if let Some(resolved) = self.successful.get(source) {
+            // This is the only configuration-sensitive arm of manifest_source. Repeat its
+            // exact validation at every original occurrence, before returning a cached ID.
+            if source.strip_prefix("registry+") == Some(blaze_manifest::source::CRATES_IO_INDEX) {
+                config.check_registry_index_not_set()?;
+            }
+            self.hits += 1;
+            source_identity_reuse_marker();
+            return Ok(resolved.clone());
+        }
+        let resolved = manifest_source(source, config)?;
+        self.successful.insert(source.to_owned(), resolved.clone());
+        Ok(resolved)
+    }
+}
+
+fn source_identity_reuse_marker() {
+    use std::io::Write as _;
+    static MARKER: std::sync::Once = std::sync::Once::new();
+    MARKER.call_once(|| {
+        let _ = std::io::stderr().lock().write_all(b"ra-jit: source-identity-reuse-v86 batch\n");
+    });
+}
+
+fn fetch_source_identity_reuse(
+    ids: &[PackageId],
+    checksums: &FxHashMap<PackageId, Option<String>>,
+    ctx: &Context,
+    sources: &blaze_registry::Sources,
+) -> Result<Vec<Package>> {
+    let mut locked = Vec::new();
+    let mut texts = Vec::new();
+    for &id in ids {
+        let source = id.source_id();
+        let source_text = source.as_url().to_string();
+        let from = sources.map().replacement(source)?;
+        if from.is_remote_registry() && !from.is_sparse() {
+            bail!("{source_text} is read from a git index, which blaze does not read yet");
+        }
+        let mut checksum = checksums.get(&id).cloned().flatten().unwrap_or_default();
+        // A lock file of cargo before 1.53 may name no checksum: the index's.
+        if checksum.is_empty() && from.is_remote_registry() {
+            checksum = sources.registry(from)?.checksum(id.name().as_str(), id.version())?;
+        }
+        let package = blaze_registry::Package {
+            name: id.name().to_string(),
+            version: id.version().clone(),
+            checksum,
+        };
+        locked.push(blaze_registry::Locked { source, package });
+        texts.push(source_text);
+    }
+    let roots = sources.fetch(&locked)?;
+    let mut read = Vec::with_capacity(texts.len());
+    let mut reuse = SourceIdentityReuse::default();
+    for (source_text, (dir, _)) in texts.into_iter().zip(roots) {
+        let manifest_path = dir.join("Cargo.toml");
+        let source = reuse.resolve(&source_text, &ctx.config)?;
+        let EitherManifest::Real(manifest) = read_manifest(&manifest_path, source, ctx)? else {
+            bail!("{} has no package", manifest_path.display());
+        };
+        read.push(Package { manifest_path, manifest, locked_source: Some(source_text) });
+    }
+    Ok(read)
+}
