+// Pinned benchmark fixture v1: opt-in, thread-owned event routing only.
+// Runtime workers inherit the fixture bus explicitly, never by event filtering.
+#[cfg(any(test, feature = "test-support"))]
+thread_local! {
+    static TEST_GLOBAL_BUS: std::cell::Cell<Option<&'static Bus>> = const {
+        std::cell::Cell::new(None)
+    };
+}
+
+#[cfg(any(test, feature = "test-support"))]
+pub struct TestGlobalBusGuard {
+    previous: Option<&'static Bus>,
+    // A thread-local override must be restored on its installing thread.
+    _thread_bound: std::marker::PhantomData<std::rc::Rc<()>>,
+}
+
+#[cfg(any(test, feature = "test-support"))]
+impl Drop for TestGlobalBusGuard {
+    fn drop(&mut self) {
+        TEST_GLOBAL_BUS.with(|slot| slot.set(self.previous));
+    }
+}
+
+#[cfg(any(test, feature = "test-support"))]
+pub fn install_test_global_bus(bus: &'static Bus) -> TestGlobalBusGuard {
+    TestGlobalBusGuard {
+        previous: TEST_GLOBAL_BUS.with(|slot| slot.replace(Some(bus))),
+        _thread_bound: std::marker::PhantomData,
+    }
+}
+
