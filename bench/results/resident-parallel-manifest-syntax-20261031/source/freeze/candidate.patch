+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+fn preparse_regular_manifests(paths: &[PathBuf]) -> Option<Vec<ParsedManifest>> {
+    use std::io::{Read as _, Write as _};
+    use std::os::unix::fs::OpenOptionsExt as _;
+
+    fn read_regular(path: &Path) -> Option<anyhow::Result<TomlManifest>> {
+        // Linux O_NONBLOCK: if a regular path is replaced by a FIFO between
+        // preflight and open, opening it must not wait for a writer. Verify the
+        // opened handle as well. This is not a filesystem snapshot guarantee.
+        // O_NOFOLLOW also declines a last-component symlink introduced after
+        // preflight. Flag values here are specific to Linux x86_64.
+        let mut file =
+            std::fs::OpenOptions::new().read(true).custom_flags(0x800 | 0x20000).open(path).ok()?;
+        if !file.metadata().ok()?.is_file() {
+            return None;
+        }
+        let mut bytes = Vec::new();
+        Some((|| {
+            file.read_to_end(&mut bytes)
+                .with_context(|| format!("failed to read `{}`", path.display()))?;
+            parse_manifest_syntax(bytes_to_contents(bytes, path)?, path)
+        })())
+    }
+
+    let workers = std::thread::available_parallelism().map_or(2, usize::from).clamp(2, 4);
+    std::thread::scope(|scope| {
+        let mut handles = Vec::new();
+        for chunk in paths.chunks(paths.len().div_ceil(workers)) {
+            let handle = std::thread::Builder::new()
+                .name("manifest-syntax".into())
+                .spawn_scoped(scope, move || {
+                    chunk
+                        .iter()
+                        .map(|path| ParsedManifest {
+                            path: path.clone(),
+                            syntax: read_regular(path),
+                        })
+                        .collect::<Vec<_>>()
+                })
+                .ok()?;
+            handles.push(handle);
+        }
+        static MARKER: std::sync::Once = std::sync::Once::new();
+        MARKER.call_once(|| {
+            let _ = writeln!(std::io::stderr().lock(), "ra-jit: parallel-manifest-parse-v81 batch");
+        });
+        let mut parsed = Vec::with_capacity(paths.len());
+        for handle in handles {
+            parsed.extend(handle.join().ok()?);
+        }
+        Some(parsed)
+    })
+}
