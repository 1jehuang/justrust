     let mut texts = Vec::new();
@@ -1319,3 +1415,231 @@ fn source_config(config: &Config) -> Result<blaze_registry::SourceConfig> {
         config.get_string("registries.crates-io.protocol")?.is_some_and(|it| it.val == "git");
